<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <Package Version="6">
    <Name Value="atsynedit_ex_package"/>
    <Type Value="RunTimeOnly"/>
    <Author Value="Alexey Torgashin"/>
    <CompilerOptions>
      <Version Value="11"/>
      <SearchPaths>
        <UnitOutputDirectory Value="lib/$(TargetCPU)-$(TargetOS)-$(LCLWidgetType)-$(FPCVer)"/>
      </SearchPaths>
      <Parsing>
        <SyntaxOptions>
          <IncludeAssertionCode Value="True"/>
        </SyntaxOptions>
      </Parsing>
      <Linking>
        <Debugging>
          <DebugInfoType Value="dsDwarf2Set"/>
        </Debugging>
      </Linking>
    </CompilerOptions>
    <Description Value="Package, additional to ATSynEdit. It has the following parts:
- Adapter for EControl lexers
- Adapter for CudaText lite lexers
- Adapter to simply highlight lines by regex

Requires packages: ATSynEdit, EControl."/>
    <License Value="MPL 2.0 or LGPL"/>
    <Version Major="2" Minor="2" Release="2"/>
    <Files>
      <Item>
        <Filename Value="atsynedit_adapter_econtrol.pas"/>
        <UnitName Value="ATSynEdit_Adapter_EControl"/>
      </Item>
      <Item>
        <Filename Value="atsynedit_adapter_litelexer.pas"/>
        <UnitName Value="ATSynEdit_Adapter_LiteLexer"/>
      </Item>
      <Item>
        <Filename Value="at__jsonconf.pp"/>
        <UnitName Value="at__jsonConf"/>
      </Item>
      <Item>
        <Filename Value="at__jsonparser.pp"/>
        <UnitName Value="at__jsonparser"/>
      </Item>
      <Item>
        <Filename Value="atsynedit_adapter_simple.pas"/>
        <UnitName Value="ATSynEdit_Adapter_Simple"/>
      </Item>
      <Item>
        <Filename Value="atsynedit_sortedrange.pas"/>
        <UnitName Value="ATSynEdit_SortedRange"/>
      </Item>
      <Item>
        <Filename Value="appjsonconfig.pp"/>
        <UnitName Value="AppJsonConfig"/>
      </Item>
    </Files>
    <RequiredPkgs>
      <Item>
        <PackageName Value="econtrol_package"/>
      </Item>
      <Item>
        <PackageName Value="atsynedit_package"/>
      </Item>
      <Item>
        <PackageName Value="FCL"/>
      </Item>
    </RequiredPkgs>
    <UsageOptions>
      <UnitPath Value="$(PkgOutDir)"/>
    </UsageOptions>
    <PublishOptions>
      <Version Value="2"/>
    </PublishOptions>
  </Package>
</CONFIG>
